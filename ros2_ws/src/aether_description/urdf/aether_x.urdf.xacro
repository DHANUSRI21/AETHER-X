<?xml version="1.0"?>
<robot name="aether_x" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Configurable chassis dimensions -->
  <xacro:arg name="base_length" default="0.60"/>
  <xacro:arg name="base_width" default="0.40"/>
  <xacro:arg name="base_height" default="0.15"/>

  <xacro:property name="base_length" value="$(arg base_length)"/>
  <xacro:property name="base_width" value="$(arg base_width)"/>
  <xacro:property name="base_height" value="$(arg base_height)"/>

  <!-- Materials -->
  <material name="dark_grey">
    <color rgba="0.18 0.20 0.23 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.10 0.35 0.85 1.0"/>
  </material>

  <material name="green">
    <color rgba="0.10 0.75 0.30 1.0"/>
  </material>

  <material name="orange">
    <color rgba="0.95 0.45 0.05 1.0"/>
  </material>

  <!-- Main robot chassis -->
  <link name="base_footprint"/>

  <link name="base_link">

    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>

    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="0.0833" ixy="0.0" ixz="0.0"
        iyy="0.1604" iyz="0.0"
        izz="0.2208"/>
    </inertial>
  </link>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0"/>
  </joint>

  <!-- IMU sensor -->
  <link name="imu_link">

    <visual>
      <geometry>
        <box size="0.04 0.04 0.02"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <inertial>
      <mass value="0.05"/>
      <inertia
        ixx="0.00001" ixy="0.0" ixz="0.0"
        iyy="0.00001" iyz="0.0"
        izz="0.00001"/>
    </inertial>
  </link>

  <joint name="base_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${base_height / 2.0 + 0.02}"
            rpy="0 0 0"/>
  </joint>

  <!-- GNSS antenna -->
  <link name="gnss_link">

    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
      <material name="green"/>
    </visual>

    <inertial>
      <mass value="0.10"/>
      <inertia
        ixx="0.00005" ixy="0.0" ixz="0.0"
        iyy="0.00005" iyz="0.0"
        izz="0.00005"/>
    </inertial>
  </link>

  <joint name="base_to_gnss" type="fixed">
    <parent link="base_link"/>
    <child link="gnss_link"/>
    <origin xyz="-0.20 0 ${base_height / 2.0 + 0.06}"
            rpy="0 0 0"/>
  </joint>

  <!-- 360-degree LiDAR -->
  <link name="lidar_link">

    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.06"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <inertial>
      <mass value="0.20"/>
      <inertia
        ixx="0.0002" ixy="0.0" ixz="0.0"
        iyy="0.0002" iyz="0.0"
        izz="0.0002"/>
    </inertial>
  </link>

  <joint name="base_to_lidar" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.15 0 ${base_height / 2.0 + 0.05}"
            rpy="0 0 0"/>
  </joint>


  <!-- Differential-drive wheel parameters -->
  <xacro:property name="wheel_radius" value="0.08"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_x_offset" value="0.20"/>
  <xacro:property name="wheel_y_offset" value="0.22"/>

  <!-- Reusable wheel model -->
  <xacro:macro name="aether_wheel" params="prefix x y">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.25"/>
        <inertia
          ixx="0.0004333" ixy="0.0" ixz="0.0"
          iyy="0.0008000" iyz="0.0"
          izz="0.0004333"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin
        xyz="${x} ${y} ${-base_height / 2.0 + wheel_radius}"
        rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="10.0" velocity="20.0"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>
  </xacro:macro>

  <!-- Four wheel assemblies -->
  <xacro:aether_wheel
    prefix="front_left"
    x="${wheel_x_offset}"
    y="${wheel_y_offset}"/>

  <xacro:aether_wheel
    prefix="rear_left"
    x="${-wheel_x_offset}"
    y="${wheel_y_offset}"/>

  <xacro:aether_wheel
    prefix="front_right"
    x="${wheel_x_offset}"
    y="${-wheel_y_offset}"/>

  <xacro:aether_wheel
    prefix="rear_right"
    x="${-wheel_x_offset}"
    y="${-wheel_y_offset}"/>

  <!-- ROS 2 Control simulated hardware -->
  <ros2_control name="AetherXMockSystem" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="calculate_dynamics">true</param>
    </hardware>

    <joint name="front_left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-20.0</param>
        <param name="max">20.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-20.0</param>
        <param name="max">20.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="front_right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-20.0</param>
        <param name="max">20.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-20.0</param>
        <param name="max">20.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>

</robot>
